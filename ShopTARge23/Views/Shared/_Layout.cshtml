<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ShopTARge23</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/spatial/css/style.css">
    <link rel="stylesheet" href="~/spatial/css/font-awesome.min.css">
    <link rel="stylesheet" href="~/spatial/css/skel.csscss">
    <link rel="stylesheet" href="~/spatial/css/style-xlarge.css">




</head>
<body>
	<!-- Header -->
	<header id="header" class="alt">
		<h1><strong><a href="index.html"></a></strong></h1>
		<nav id="nav">
			<ul>
				<li><a class="nav-link text-dark" asp-controller="Home" asp-action="Index">Home</a></li>
				<li><a class="nav-link text-dark" asp-controller="Home" asp-action="Privacy">Privacy</a></li>
				<li><a class="nav-link text-dark" asp-controller="Spaceships" asp-action="Index">Spaceship</a></li>
				<li><a class="nav-link text-dark" asp-controller="RealEstate" asp-action="Index">Real Estate</a></li>
                <li><a class="nav-link text-dark" asp-controller="AccuWeathers" asp-action="Index">Accu Weather</a></li>
                <li><a class="nav-link text-dark" asp-controller="ChuckNorris" asp-action="Index">Chuck Norris</a></li>
                <li><a class="nav-link text-dark" asp-controller="Games" asp-action="Index">Games</a></li>
                <li><a class="nav-link text-dark" asp-controller="Drink" asp-action="Index">Drinks</a></li>
                <li><a class="nav-link text-dark" asp-controller="OpenWeather" asp-action="Index">Open Weather</a></li>



			</ul>
		</nav>
	</header>


	
    <div container mt-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2024 - ShopTARge23 - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/spatial/js/html5shiv.js"></script>
    <script src="~/spatial/js/init.js"></script>
    <script src="~/spatial/js/jquery.min.js"></script>
    <script src="~/spatial/js/skel-layers.min.js"></script>
    <script src="~/spatial/js/skel.min.js"></script>




    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
