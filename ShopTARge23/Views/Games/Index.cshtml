@model List<ShopTARge23.Core.Dto.Games.GameRootDto>

@{
    // You can check if the model is null or has no games
    var hasGames = Model != null && Model.Any();
}

<h2>Games List</h2>

@if (!hasGames)
{
    <p>No games available.</p>
}
else
{
    <div class="games-container">
        @foreach (var game in Model)
        {
            <div class="game-card">
                <img src="@game.thumbnail" alt="@game.title" class="game-thumbnail" />
                <h3>@game.title</h3>
                <p>@game.short_description</p>
                <a href="@game.game_url" target="_blank">Play Now</a>
            </div>
        }
    </div>
}

<style>
    .games-container {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
        gap: 20px;
    }

    .game-card {
        border: 1px solid #ddd;
        padding: 15px;
        border-radius: 8px;
        text-align: center;
        background-color: #f9f9f9;
    }

    .game-thumbnail {
        width: 100%;
        height: 150px;
        object-fit: cover;
        border-radius: 8px;
    }

    h3 {
        font-size: 1.2em;
        margin: 10px 0;
    }

    p {
        font-size: 1em;
        color: #555;
    }

    a {
        display: inline-block;
        padding: 10px 20px;
        background-color: #007BFF;
        color: white;
        text-decoration: none;
        border-radius: 4px;
        margin-top: 10px;
    }

        a:hover {
            background-color: #0056b3;
        }
</style>
