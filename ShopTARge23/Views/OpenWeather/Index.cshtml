@model ShopTARge23.Models.OpenWeather.OpenWeatherIndex

@{
    ViewData["Title"] = "Search Weather";
}
<div class="container container-custom">

<div class="container mt-4">
    <h1>Search Weather</h1>

    <form asp-action="CityData" asp-controller="OpenWeather" method="post">
        <div class="mb-3">
            <label for="city" class="form-label">City Name:</label>
            <input type="text" id="city" name="city" class="form-control" required />
        </div>
        
        <button type="submit" class="btn btn-success">Get Weather</button>
    </form>
</div>
</div>