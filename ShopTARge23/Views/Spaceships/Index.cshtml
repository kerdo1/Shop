@model IEnumerable<ShopTARge23.Models.Spaceships.SpaceshipsIndexViewModel>

@{
    int rowNumber = 1;
}


<!-- Banner -->
<section id="banner">



    <div class="container spaceships-content">
        <main role="main" class="pb-3">
            <!-- Title -->
            <div class="row mb-2">
                <div class="col-auto">
                    <h1 style="color: white;">Spaceships</h1>
                </div>
            </div>


            <!-- Create Button -->
            <div class="row mb-4">
                <div class="col-auto">
                    <a asp-action="create" asp-controller="Spaceships" class="btn btn-primary">Create</a>
                </div>
            </div>

        <form method="post">
            <table class="table table-hover">
                    <thead class="table-header-text">
                        <tr style="color: #dfe1e6 !important; background-color: #71797E;">
                        <th scope="col">Nr</th>
                        <th scope="col">Name</th>
                        <th scope="col">Type</th>
                        <th scope="col">Built date</th>
                        <th scope="col">Crew</th>
                        <th scope="col"></th>
                    </tr>
                </thead>
                <tbody >
                    @foreach (var spaceship in Model)
                    {
                            <tr style="background-color: #36454F; color: #dfe1e6;">
                            <td>@rowNumber</td>
                            <td>@spaceship.Name</td>
                            <td>@spaceship.Typename</td>
                            <td>@spaceship.BuiltDate</td>
                            <td>@spaceship.Crew</td>
                            <td>
                                    <a asp-action="details" asp-controller="Spaceships" asp-route-id="@spaceship.Id" class="btn btn-warning">Details</a>
                                <a asp-action="update" asp-controller="Spaceships" asp-route-id="@spaceship.Id" class="btn btn-primary">Update</a>
                                <a asp-action="delete" asp-controller="Spaceships" asp-route-id="@spaceship.Id" class="btn btn-danger">Delete</a>
                            </td>
                        </tr>
                        rowNumber += 1;
                    }
                </tbody>
            </table>
        </form>
    </main>
</div>
</section>