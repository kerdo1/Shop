@model ShopTARge23.Models.Spaceships.SpaceshipCreateUpdateViewModel

<section id="banner">
    <div class="container spaceships-content">
        <main role="main" class="pb-3">

            <!-- Title -->
            <div class="row mb-2">
                <div class="col-auto">
                    <h1 style="color: white;">@((Model.Id.HasValue) ? "Update Spaceship" : "Create Spaceship")</h1>
                </div>
            </div>

            <div class="form-container" style="background-color: #36454F; padding: 20px; border-radius: 8px;">
                <form method="post" enctype="multipart/form-data">
                    <input asp-for="Id" type="hidden" />
                    <input asp-for="CreatedAt" type="hidden" />
                    <input asp-for="ModifiedAt" type="hidden" />

                    <!-- Name Field -->
                    <div class="form-group row">
                        <label asp-for="Name" class="col-sm-2 col-form-label" style="color: #dfe1e6;">Name</label>
                        <div class="col-sm-10">
                            <input asp-for="Name" class="form-control" style="background-color: #3e3c45; color: #dfe1e6;" />
                        </div>
                    </div>

                    <!-- Type Field -->
                    <div class="form-group row">
                        <label asp-for="Typename" class="col-sm-2 col-form-label" style="color: #dfe1e6;">Type</label>
                        <div class="col-sm-10">
                            <input asp-for="Typename" class="form-control" style="background-color: #3e3c45; color: #dfe1e6;" />
                        </div>
                    </div>

                    <!-- Spaceship Model Field -->
                    <div class="form-group row">
                        <label asp-for="SpaceshipModel" class="col-sm-2 col-form-label" style="color: #dfe1e6;">Model</label>
                        <div class="col-sm-10">
                            <input asp-for="SpaceshipModel" class="form-control" style="background-color: #3e3c45; color: #dfe1e6;" />
                        </div>
                    </div>

                    <!-- Built Date Field -->
                    <div class="form-group row">
                        <label asp-for="BuiltDate" class="col-sm-2 col-form-label" style="color: #dfe1e6;">Built Date</label>
                        <div class="col-sm-10">
                            <input asp-for="BuiltDate" class="form-control" style="background-color: #3e3c45; color: #dfe1e6;" />
                        </div>
                    </div>

                    <!-- Crew Field -->
                    <div class="form-group row">
                        <label asp-for="Crew" class="col-sm-2 col-form-label" style="color: #dfe1e6;">Crew</label>
                        <div class="col-sm-10">
                            <input asp-for="Crew" class="form-control" style="background-color: #3e3c45; color: #dfe1e6;" />
                        </div>
                    </div>

                    <!-- Engine Power Field -->
                    <div class="form-group row">
                        <label asp-for="EnginePower" class="col-sm-2 col-form-label" style="color: #dfe1e6;">Engine Power</label>
                        <div class="col-sm-10">
                            <input asp-for="EnginePower" class="form-control" style="background-color: #3e3c45; color: #dfe1e6;" />
                        </div>
                    </div>

                    <!-- File Upload -->
                    <div class="form-group row">
                        <label asp-for="Files" class="col-sm-2 col-form-label" style="color: #dfe1e6;">Upload Files</label>
                        <div class="col-sm-5">
                            <div class="custom-file">
                                <input class="form-control" asp-for="Files" multiple type="file" style="background-color: #3e3c45; color: #dfe1e6;" />
                            </div>
                        </div>
                    </div>

                    <!-- Display Images -->
                    @foreach (var images in Model.Image)
                    {
                            <partial name="_Images" model="images" />
                    }

                    <hr />

                    <!-- Submit Button -->
                    <div class="form-group row">
                        <div class="col-sm-10">
                            @if (Model.Id.HasValue)
                            {
                                    <input asp-action="update" asp-controller="spaceships" type="submit" class="btn btn-primary btn-sm" value="Update" />
                            }
                            else
                            {
                                    <input asp-action="create" asp-controller="spaceships" type="submit" class="btn btn-primary btn-sm" value="Create" />
                            }
                            <a asp-action="Index" asp-controller="spaceships" class="btn btn-success  btn-lg">Back</a>
                        </div>
                    </div>
                </form>
            </div>
        </main>
    </div>
</section>
