@model IEnumerable<ShopTARge23.Models.RealEstates.RealEstateIndexViewModel>

@{
    int rowNumber = 1;
}

<!-- Banner -->
<section id="banner1">
    <div class="container real-estate-content">
        <main role="main" class="pb-3">
            <!-- Title -->
            <div class="row mb-2">
                <div class="col-auto">
                    <h1 style="color: white;">Real Estate</h1>
                </div>
            </div>

            <!-- Create Button -->
            <div class="row mb-4">
                <div class="col-auto">
                    <a asp-action="create" asp-controller="RealEstate" class="btn btn-primary">Create</a>
                </div>
            </div>

            <form method="post">
                <table class="table table-hover">
                    <thead class="table-header-text">
                        <tr style="color: #dfe1e6 !important; background-color: #71797E;">
                            <th scope="col">Nr</th>
                            <th scope="col">Size</th>
                            <th scope="col">Location</th>
                            <th scope="col">Room Number</th>
                            <th scope="col">Building Type</th>
                            <th scope="col">Created At</th>
                            <th scope="col"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var realEstate in Model)
                        {
                            <tr style="background-color: #36454F; color: #dfe1e6;">
                                <td>@rowNumber</td>
                                <td>@realEstate.Size</td>
                                <td>@realEstate.Location</td>
                                <td>@realEstate.RoomNumber</td>
                                <td>@realEstate.BuildingType</td>
                                <td>@realEstate.CreatedAt</td>
                                <td>
                                    <a asp-action="details" asp-controller="RealEstate" asp-route-id="@realEstate.Id" class="btn btn-warning">Details</a>
                                    <a asp-action="update" asp-controller="RealEstate" asp-route-id="@realEstate.Id" class="btn btn-primary">Update</a>
                                    <a asp-action="delete" asp-controller="RealEstate" asp-route-id="@realEstate.Id" class="btn btn-danger">Delete</a>
                                </td>
                            </tr>
                            rowNumber += 1;
                        }
                    </tbody>
                </table>
            </form>
        </main>
    </div>
</section>
